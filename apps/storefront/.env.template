# Publishable API key from Medusa Admin > Settings > Publishable API Keys.
# The seed prints it at the end of `medusa db:migrate`.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL of the Medusa backend.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Garb sells in Canada only.
NEXT_PUBLIC_DEFAULT_REGION=ca

# Public URL of this storefront (canonical URLs, sitemap, emails).
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Stripe publishable key. Leave empty to offer e-Transfer only.
NEXT_PUBLIC_STRIPE_KEY=

# Where e-Transfers are sent (shown at checkout and on the order page).
NEXT_PUBLIC_ETRANSFER_EMAIL=consign@garb.ca

# Shared secret the backend uses to refresh cached pages when stock changes.
# Set the same value as REVALIDATE_SECRET in apps/backend/.env.
REVALIDATE_SECRET=
