# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/garb

# Redis (event bus, workflow engine, locking). Leave empty to use in-memory versions in development.
REDIS_URL=redis://localhost:6379

# CORS: storefront, admin and auth origins
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# Change these in production
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
AUTH_MFA_ENCRYPTION_KEY=

# Public URLs (used for image URLs, emails and invite links)
MEDUSA_BACKEND_URL=http://localhost:9000
STOREFRONT_URL=http://localhost:8000

# Card payments. Leave empty to offer e-Transfer only.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Garb settings
GARB_STORE_EMAIL=consign@garb.ca
GARB_ETRANSFER_EMAIL=consign@garb.ca
# Unpaid e-Transfer orders are cancelled after this many hours
GARB_UNPAID_ORDER_HOURS=72
# Same value as REVALIDATE_SECRET in the storefront; refreshes cached pages when stock changes
REVALIDATE_SECRET=
